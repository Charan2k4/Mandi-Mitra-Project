# Environment Configuration for Mandi Mitra

# Backend Configuration
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL Database URL
# Example Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or Supabase Transaction Pooler:
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres
# If left blank, Mandi Mitra uses a local SQLite fallback database (sqlite:///./mandi_mitra.db) for instant local testing!
DATABASE_URL=

# Agmarknet / Data.gov.in API Key
# Register at https://data.gov.in/ to get a free API Key
# If omitted or invalid, Mandi Mitra automatically falls back to verified authentic historical and sample benchmark data.
DATA_GOV_IN_API_KEY=

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000/api
